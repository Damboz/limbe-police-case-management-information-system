# Copy to .env and fill in. On Render, set these as environment variables instead.
# Never commit the filled-in .env: it holds the database password.

PORT=3000
NODE_ENV=development

# Browser origins allowed to call this API. Comma-separate for more than one.
# Must be the exact scheme+host, no trailing slash, no path.
# Set to your Vercel domain in production, e.g. https://limbe-police-cms.vercel.app
CLIENT_ORIGIN=http://localhost:5173

PGHOST='localhost'
PGDATABASE='limbe_police'
PGUSER='postgres'
PGPASSWORD=''
PGSSLMODE='disable'
PGCHANNELBINDING='require'

# Mandatory. Generate your own; a published value would let anyone forge a session.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Brevo transactional email (used to send login credentials to new officers).
# Get the API key from https://app.brevo.com/settings/keys/api
BREVO_API_KEY=
# The sender address must be verified under Brevo > Senders & Domains.
BREVO_SENDER_EMAIL=
# Public URL of the React app, used for the login link inside the email.
FRONTEND_URL=http://localhost:5173