{
  "name": "limbe-police-cms",
  "version": "1.0.0",
  "private": true,
  "description": "Limbe Police Station Case Management System - Express API and React client",
  "workspaces": [
    "backend",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n backend,client -c blue,magenta \"npm:dev:backend\" \"npm:dev:client\"",
    "dev:backend": "npm run dev --workspace backend",
    "dev:client": "npm run dev --workspace client",
    "build": "npm run build --workspace client",
    "start": "npm run start --workspace backend"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
